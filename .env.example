# Copia questo file in ".env" (senza .example) e inserisci le tue chiavi VERE.
# Il file ".env" non verra' mai caricato su GitHub: e' escluso in .gitignore.

# Chiavi Alpaca - AMBIENTE PAPER (simulazione)
# Le trovi nella dashboard di Alpaca, sezione "Paper Trading" -> "API Keys"
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# In futuro, se si passera' a un conto reale, qui andranno le chiavi LIVE
# separate, cosi' le due cose restano ben distinte.
